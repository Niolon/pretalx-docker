#, python-format
msgid ""
"You, %(name)s, have been invited to be a speaker for the session “%(talk)s”."
" Do you accept the invitation?"
msgstr ""
"You, %(name)s, have been invited to be an applicant for the interview "
"“%(talk)s”. Do you accept the invitation?"

